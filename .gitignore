# ============================================================
#  运行期数据 —— 绝不入库
# ============================================================
# 音色库：里面是具体人的声音样本，涉及声音权，且体积随使用增长
voices/
voices_backup/
# 场景音效：体积大，且不适合随仓库分发（音效由使用者自备，或由整合包提供）
pjy/
# 侧车的其它产物
outputs/

# ============================================================
#  日志与缓存
# ============================================================
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
#  PyInstaller 构建产物
# ============================================================
# 源码（server/breeze_api.py + spec + build-exe.cmd）入库，
# 产物不入库 —— 它可以从源码一条命令重建出来。
# 分发给用户的 exe 位于整合包的 sidecar\ 目录，不在本仓库里。
build/
dist/
*.manifest

# ============================================================
#  整合包组装产物
# ============================================================
# package/ 下**只**收录组装脚本与文档素材，其余一律忽略。
#
# 这里刻意用「除了这几个之外全忽略」而不是逐个列出产物名：产物名字是不可预测的。
# 踩过的坑——压缩包叫 月声整合包.zip 时，解压工具默认会建一个**同名文件夹**放在旁边，
# 那就是一份 7.9 GB 的成品；而当时只忽略了 *.zip，于是 package/月声整合包/ 直接挂在
# git status 里，一次 git add -A 就会把整个 7.9 GB 往索引里塞。
#
# 往 package/ 里加新的源码/素材时，记得在下面补一行 ! 例外。
package/*
!package/build-package.py
!package/make-launchers.py
!package/make-model-zip.py
!package/readme.txt
!package/docs/
!package/launchers/

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
