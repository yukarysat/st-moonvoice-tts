# ============================================================
#  运行期数据 —— 绝不入库
# ============================================================
# 音色库：里面是具体人的声音样本，涉及声音权，且体积随使用增长
voices/
voices_backup/
# 场景音效：体积大，且不适合随仓库分发（音效由使用者自备，或由整合包提供）
pjy/
# 侧车的其它产物
outputs/

# ============================================================
#  日志与缓存
# ============================================================
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
#  PyInstaller 构建产物
# ============================================================
# 源码（server/breeze_api.py + spec + build-exe.cmd）入库，
# 产物不入库 —— 它可以从源码一条命令重建出来。
# 分发给用户的 exe 位于整合包的 sidecar\ 目录，不在本仓库里。
build/
dist/
*.manifest

# ============================================================
#  整合包组装产物
# ============================================================
# package/ 下的组装脚本与素材入库；
# MoonVoice/ 是组装出来的成品（约 7.9 GB，且大文件是硬链接），绝不入库。
# 原因：体积远超仓库承载能力，且它本质是第三方运行时 + 模型 + 构建产物的集合，
# 每次都能由 build-package.py 重新生成。
package/MoonVoice/
package/*.zip

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
